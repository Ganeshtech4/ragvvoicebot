# =========================================================================
# Voice RAG Chatbot - Multi-Tenant Environment Configuration Example
# =========================================================================

# -------------------------------------------------------------------------
# LLM Config (Choices: 'mock', 'openai', 'anthropic', 'gemini', 'custom')
# -------------------------------------------------------------------------
LLM_PROVIDER=mock
LLM_API_KEY=your_llm_api_key_here
LLM_API_URL=
LLM_MODEL=gemini-2.5-flash

# -------------------------------------------------------------------------
# Speech-To-Text (STT) Config (Choices: 'mock', 'openai', 'custom')
# -------------------------------------------------------------------------
STT_PROVIDER=mock
STT_API_KEY=your_stt_api_key_here
# Use http://host.docker.internal:8001/transcribe for the local Faster-Whisper service
STT_API_URL=https://api.openai.com/v1/audio/transcriptions
STT_MODEL=whisper-1

# -------------------------------------------------------------------------
# Text-To-Speech (TTS) Config (Choices: 'mock', 'openai', 'custom')
# -------------------------------------------------------------------------
TTS_PROVIDER=mock
TTS_API_KEY=your_tts_api_key_here
# Use http://host.docker.internal:8002/speak for the local Edge-TTS service
TTS_API_URL=https://api.openai.com/v1/audio/speech
TTS_MODEL=tts-1
# Default voice for local Edge-TTS is en-US-AvaNeural (can be changed here)
TTS_VOICE=alloy

# -------------------------------------------------------------------------
# Database URL (Default matches docker-compose settings)
# -------------------------------------------------------------------------
DATABASE_URL=postgresql://voice_rag_user:voice_rag_password@postgres:5432/voice_rag_db

# -------------------------------------------------------------------------
# Redis URL
# -------------------------------------------------------------------------
REDIS_URL=redis://redis:6379